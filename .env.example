# Set these in Vercel -> Project -> Settings -> Environment Variables
SUPABASE_URL=https://ymvhnwcteeonvwhhoksd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...            # public key
SUPABASE_SERVICE_ROLE_KEY=                      # SECRET - never put in frontend/GitHub
OWNER_USER_ID=                                  # your admin account's user UUID (Supabase -> Authentication -> Users)
GEMINI_API_KEY=                                 # SECRET
# Optional
GEMINI_MODEL=gemini-3.8-flash
FREE_TRIAL_CHAT_LIMIT=100

# EmailJS (server-side only; never expose the private key in frontend code)
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_WELCOME_TEMPLATE_ID=
EMAILJS_NOTIFY_TEMPLATE_ID=
EMAILJS_ADMIN_EMAIL=
