{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/widget.js", "dest": "/widget.js" },
    { "src": "/test.html", "dest": "/test.html" },
    { "src": "/test", "dest": "/index.html" },
    { "src": "/admin", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
